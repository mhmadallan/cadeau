PORT=4000
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-publishable-key
CORS_ORIGINS=http://localhost:5500,https://your-username.github.io

# Select one notification channel. WhatsApp settings can stay in place.
ORDER_NOTIFICATION_PROVIDER=telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Server-only WhatsApp Cloud API settings. Never put the access token in public/config.js.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Destination number: country code and digits only, no leading +.
WHATSAPP_RECIPIENT_NUMBER=
# Set to a supported Graph API version from your Meta dashboard (format: vNN.0).
WHATSAPP_API_VERSION=
WHATSAPP_TEMPLATE_NAME=cadeau_order_notification
WHATSAPP_TEMPLATE_LANGUAGE=en_US
# Set image when the existing WHATSAPP_TEMPLATE_NAME has an approved IMAGE header.
# In image mode, every WhatsApp order requires a product image (no text fallback).
WHATSAPP_TEMPLATE_HEADER=image
# Optional approved IMAGE-header template with the same nine body parameters.
# Keep WHATSAPP_TEMPLATE_NAME as the text-only fallback for products without images.
WHATSAPP_IMAGE_TEMPLATE_NAME=

# Webhook verification token: generate a random secret and use the same value in Meta.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Meta app Settings > Basic > App secret (not the WhatsApp access token).
META_APP_SECRET=

# Separate text-only WhatsApp templates; body parameters: customer name, phone.
WHATSAPP_ACCESS_REQUEST_TEMPLATE=
WHATSAPP_ACCESS_APPROVED_TEMPLATE=
WHATSAPP_ACCESS_TEMPLATE_LANGUAGE=en
